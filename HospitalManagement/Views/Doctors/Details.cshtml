@model Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="data-card mb-4">
    <div class="data-card-header">
        <h5><i class="bi bi-person-badge"></i> @Model.FullName</h5>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-sm btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
        </div>
    </div>
    <div class="p-4">
        <div class="row g-3">
            <div class="col-md-4"><strong>Specialization:</strong> @Model.Specialization</div>
            <div class="col-md-4"><strong>Experience:</strong> @Model.ExperienceYears years</div>
            <div class="col-md-4"><strong>Available Days:</strong> @Model.AvailableDays</div>
            <div class="col-md-4"><strong>Email:</strong> @Model.Email</div>
            <div class="col-md-4"><strong>Phone:</strong> @Model.PhoneNumber</div>
        </div>
    </div>
</div>

@if (Model.Appointments.Any())
{
    <div class="data-card">
        <div class="data-card-header"><h5><i class="bi bi-calendar-check"></i> Appointments</h5></div>
        <div class="table-responsive">
            <table class="table data-table mb-0">
                <thead><tr><th>Patient</th><th>Date</th><th>Time</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Appointments.OrderByDescending(x => x.AppointmentDate).Take(10))
                    {
                        <tr>
                            <td>@a.Patient.FullName</td>
                            <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                            <td>@a.AppointmentTime.ToString(@"hh\:mm")</td>
                            <td><span class="badge-status badge-@a.Status.ToLower()">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
