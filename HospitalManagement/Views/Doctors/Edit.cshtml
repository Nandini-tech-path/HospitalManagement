@model Doctor
@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="form-card">
    <h4 class="form-section-title"><i class="bi bi-pencil me-2"></i>Edit Doctor</h4>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="DoctorId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><div class="form-floating"><input asp-for="FullName" class="form-control" /><label asp-for="FullName"></label><span asp-validation-for="FullName" class="text-danger"></span></div></div>
            <div class="col-md-6"><div class="form-floating"><input asp-for="Specialization" class="form-control" /><label asp-for="Specialization"></label><span asp-validation-for="Specialization" class="text-danger"></span></div></div>
            <div class="col-md-6"><div class="form-floating"><input asp-for="Email" class="form-control" /><label asp-for="Email"></label><span asp-validation-for="Email" class="text-danger"></span></div></div>
            <div class="col-md-6"><div class="form-floating"><input asp-for="PhoneNumber" class="form-control" /><label asp-for="PhoneNumber"></label><span asp-validation-for="PhoneNumber" class="text-danger"></span></div></div>
            <div class="col-md-6"><div class="form-floating"><input asp-for="ExperienceYears" class="form-control" type="number" /><label asp-for="ExperienceYears"></label></div></div>
            <div class="col-md-6"><div class="form-floating"><input asp-for="AvailableDays" class="form-control" /><label asp-for="AvailableDays"></label></div></div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
