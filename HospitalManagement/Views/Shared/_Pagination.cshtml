@{
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var search = ViewBag.Search as string;
    var sort = ViewBag.Sort as string;
    var sortDesc = (bool)(ViewBag.SortDesc ?? false);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

@if (totalPages > 1)
{
    <nav class="pagination-nav" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="@controller" asp-action="@action" asp-route-page="@(page - 1)" asp-route-search="@search" asp-route-sort="@sort" asp-route-sortDesc="@sortDesc">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-controller="@controller" asp-action="@action" asp-route-page="@i" asp-route-search="@search" asp-route-sort="@sort" asp-route-sortDesc="@sortDesc">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="@controller" asp-action="@action" asp-route-page="@(page + 1)" asp-route-search="@search" asp-route-sort="@sort" asp-route-sortDesc="@sortDesc">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
