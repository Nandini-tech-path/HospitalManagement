@model ReceptionistDashboardViewModel
@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon green"><i class="bi bi-person-plus"></i></div>
            <div class="stat-card-value">@Model.NewRegistrations</div>
            <div class="stat-card-label">New Registrations (7 days)</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon orange"><i class="bi bi-calendar-day"></i></div>
            <div class="stat-card-value">@Model.TodayAppointments</div>
            <div class="stat-card-label">Today's Appointments</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon blue"><i class="bi bi-receipt"></i></div>
            <div class="stat-card-value">$@Model.TotalBilled.ToString("N0")</div>
            <div class="stat-card-label">Total Billed</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon purple"><i class="bi bi-clock-history"></i></div>
            <div class="stat-card-value">$@Model.PendingPayments.ToString("N0")</div>
            <div class="stat-card-label">Pending Payments</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="data-card">
            <div class="data-card-header">
                <h5><i class="bi bi-people"></i> Recent Registrations</h5>
                <a asp-controller="Patients" asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus"></i> Register Patient</a>
            </div>
            <div class="table-responsive">
                <table class="table data-table mb-0">
                    <thead><tr><th>Name</th><th>Registered</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.RecentPatients)
                        {
                            <tr>
                                <td>@p.FullName</td>
                                <td>@p.RegistrationDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="data-card">
            <div class="data-card-header">
                <h5><i class="bi bi-calendar-day"></i> Today's Appointments</h5>
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus"></i> Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table data-table mb-0">
                    <thead><tr><th>Patient</th><th>Doctor</th><th>Time</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.TodaySchedule)
                        {
                            <tr>
                                <td>@a.PatientName</td>
                                <td>@a.DoctorName</td>
                                <td>@a.AppointmentTime.ToString(@"hh\:mm")</td>
                                <td><span class="badge-status badge-@a.Status.ToLower()">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="data-card">
            <div class="data-card-header">
                <h5><i class="bi bi-cash-stack"></i> Billing Summary</h5>
                <a asp-controller="Bills" asp-action="Index" class="btn btn-sm btn-outline-primary">View Bills</a>
            </div>
            <div class="p-4">
                <div class="row text-center">
                    <div class="col-md-6">
                        <div class="stat-card-value text-success">@Model.PaidBills</div>
                        <div class="stat-card-label">Paid Bills</div>
                    </div>
                    <div class="col-md-6">
                        <div class="stat-card-value text-warning">@Model.PendingBills</div>
                        <div class="stat-card-label">Pending Bills</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
