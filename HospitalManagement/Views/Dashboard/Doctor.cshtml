@model DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-card-icon orange"><i class="bi bi-calendar-day"></i></div>
            <div class="stat-card-value">@Model.TodayAppointments</div>
            <div class="stat-card-label">Today's Appointments</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-card-icon blue"><i class="bi bi-calendar-week"></i></div>
            <div class="stat-card-value">@Model.UpcomingAppointments</div>
            <div class="stat-card-label">Upcoming Appointments</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="data-card">
            <div class="data-card-header">
                <h5><i class="bi bi-calendar-day"></i> Today's Schedule</h5>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table data-table mb-0">
                    <thead><tr><th>Patient</th><th>Time</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.TodaySchedule.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">No appointments today</td></tr>
                        }
                        @foreach (var a in Model.TodaySchedule)
                        {
                            <tr>
                                <td>@a.PatientName</td>
                                <td>@a.AppointmentTime.ToString(@"hh\:mm")</td>
                                <td><span class="badge-status badge-@a.Status.ToLower()">@a.Status</span></td>
                                <td>
                                    @if (a.Status == "Scheduled")
                                    {
                                        <a asp-controller="Appointments" asp-action="Complete" asp-route-id="@a.AppointmentId" class="btn btn-sm btn-success btn-action">Complete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="data-card">
            <div class="data-card-header">
                <h5><i class="bi bi-calendar-week"></i> Upcoming Schedule</h5>
            </div>
            <div class="table-responsive">
                <table class="table data-table mb-0">
                    <thead><tr><th>Patient</th><th>Date</th><th>Time</th></tr></thead>
                    <tbody>
                        @if (!Model.UpcomingSchedule.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted">No upcoming appointments</td></tr>
                        }
                        @foreach (var a in Model.UpcomingSchedule)
                        {
                            <tr>
                                <td>@a.PatientName</td>
                                <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                                <td>@a.AppointmentTime.ToString(@"hh\:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="data-card">
            <div class="data-card-header">
                <h5><i class="bi bi-people"></i> Assigned Patients</h5>
            </div>
            <div class="table-responsive">
                <table class="table data-table mb-0">
                    <thead><tr><th>Name</th><th>Gender</th><th>Age</th><th>Blood Group</th></tr></thead>
                    <tbody>
                        @if (!Model.AssignedPatients.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">No assigned patients</td></tr>
                        }
                        @foreach (var p in Model.AssignedPatients)
                        {
                            <tr>
                                <td>@p.FullName</td>
                                <td>@p.Gender</td>
                                <td>@p.Age</td>
                                <td>@(p.BloodGroup ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
