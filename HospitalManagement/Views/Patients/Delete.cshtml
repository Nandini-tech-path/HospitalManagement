@model Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<div class="form-card">
    <h4 class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Patient</h4>
    <p>Are you sure you want to delete <strong>@Model.FullName</strong>?</p>
    <dl class="row">
        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.PhoneNumber</dd>
        <dt class="col-sm-3">Registered</dt><dd class="col-sm-9">@Model.RegistrationDate.ToString("MMM dd, yyyy")</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="PatientId" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
