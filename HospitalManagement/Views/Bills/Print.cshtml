@model Bill
@{
    ViewData["Title"] = "Print Bill";
    Layout = "_DashboardLayout";
}

<div class="no-print mb-3">
    <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i>Print</button>
    <a asp-action="Details" asp-route-id="@Model.BillId" class="btn btn-outline-secondary">Back</a>
</div>

<div class="print-bill">
    <div class="print-header text-center">
        <h2><i class="bi bi-hospital"></i> MediCare Hospital</h2>
        <p class="text-muted mb-0">123 Healthcare Avenue, Springfield | Tel: (555) 123-4567</p>
    </div>
    <div class="row mb-4">
        <div class="col-6">
            <h5>Bill To:</h5>
            <p class="mb-0"><strong>@Model.Patient.FullName</strong></p>
            <p class="mb-0">@(Model.Patient.Address ?? "")</p>
            <p class="mb-0">@Model.Patient.PhoneNumber</p>
        </div>
        <div class="col-6 text-end">
            <p><strong>Bill #:</strong> @Model.BillId</p>
            <p><strong>Date:</strong> @DateTime.Today.ToString("MMM dd, yyyy")</p>
            <p><strong>Doctor:</strong> @Model.Appointment.Doctor.FullName</p>
        </div>
    </div>
    <table class="table table-bordered">
        <thead class="table-light"><tr><th>Description</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
            <tr><td>Consultation Fee</td><td class="text-end">$@Model.ConsultationFee.ToString("N2")</td></tr>
            <tr><td>Medicine Charges</td><td class="text-end">$@Model.MedicineCharges.ToString("N2")</td></tr>
            <tr><td>Other Charges</td><td class="text-end">$@Model.OtherCharges.ToString("N2")</td></tr>
            <tr class="fw-bold"><td>Total</td><td class="text-end">$@Model.TotalAmount.ToString("N2")</td></tr>
        </tbody>
    </table>
    <p class="mt-3"><strong>Payment Status:</strong> @Model.PaymentStatus</p>
    <p class="text-muted text-center mt-5">Thank you for choosing MediCare Hospital</p>
</div>
