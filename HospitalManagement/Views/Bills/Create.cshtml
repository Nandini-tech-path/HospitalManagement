@model Bill
@{
    ViewData["Title"] = "Generate Bill";
}

<div class="form-card">
    <h4 class="form-section-title"><i class="bi bi-receipt me-2"></i>Generate Bill</h4>
    <form asp-action="Create" method="post" id="billForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-floating">
                    <select asp-for="AppointmentId" class="form-select" asp-items="ViewBag.AppointmentId" id="appointmentSelect"></select>
                    <label asp-for="AppointmentId">Appointment</label>
                    <span asp-validation-for="AppointmentId" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <select asp-for="PatientId" class="form-select" asp-items="ViewBag.PatientId"></select>
                    <label asp-for="PatientId">Patient</label>
                    <span asp-validation-for="PatientId" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="ConsultationFee" class="form-control fee-input" type="number" step="0.01" min="0" />
                    <label asp-for="ConsultationFee"></label>
                    <span asp-validation-for="ConsultationFee" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="MedicineCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                    <label asp-for="MedicineCharges"></label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="OtherCharges" class="form-control fee-input" type="number" step="0.01" min="0" />
                    <label asp-for="OtherCharges"></label>
                </div>
            </div>
            <div class="col-12">
                <div class="alert alert-info">
                    <strong>Total Amount:</strong> $<span id="totalAmount">0.00</span>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Generate Bill</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateTotal() {
            const c = parseFloat(document.querySelector('[name="ConsultationFee"]').value) || 0;
            const m = parseFloat(document.querySelector('[name="MedicineCharges"]').value) || 0;
            const o = parseFloat(document.querySelector('[name="OtherCharges"]').value) || 0;
            document.getElementById('totalAmount').textContent = (c + m + o).toFixed(2);
        }
        document.querySelectorAll('.fee-input').forEach(el => el.addEventListener('input', updateTotal));
        updateTotal();
    </script>
}
